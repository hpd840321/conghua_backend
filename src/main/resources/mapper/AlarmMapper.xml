<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.conghua.tourism.mapper.AlarmMapper">
    
    <!-- 继承基础列 -->
    <sql id="Column_List">
        <include refid="com.conghua.tourism.common.mapper.BaseMapper.Base_Column_List"/>,
        scenic_spot_id, alarm_type, alarm_level, alarm_content, handle_status, handle_time, handle_result, handler
    </sql>

    <!-- 继承基础条件并扩展 -->
    <sql id="Where_Clause">
        <where>
            <include refid="com.conghua.tourism.common.mapper.BaseMapper.Base_Where_Clause"/>
            <if test="scenicSpotId != null">
                AND scenic_spot_id = #{scenicSpotId}
            </if>
            <if test="alarmType != null">
                AND alarm_type = #{alarmType}
            </if>
            <if test="alarmLevel != null">
                AND alarm_level = #{alarmLevel}
            </if>
            <if test="handleStatus != null">
                AND handle_status = #{handleStatus}
            </if>
            <if test="startTime != null">
                AND create_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND create_time &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <!-- 插入告警信息 -->
    <insert id="insert" parameterType="com.conghua.tourism.model.Alarm" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_alarm
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="com.conghua.tourism.common.mapper.BaseMapper.Base_Insert_Column"/>
            <if test="scenicSpotId != null">scenic_spot_id,</if>
            <if test="alarmType != null">alarm_type,</if>
            <if test="alarmLevel != null">alarm_level,</if>
            <if test="alarmContent != null">alarm_content,</if>
            <if test="handleStatus != null">handle_status,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="handleResult != null">handle_result,</if>
            <if test="handler != null">handler,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="com.conghua.tourism.common.mapper.BaseMapper.Base_Insert_Value"/>
            <if test="scenicSpotId != null">#{scenicSpotId},</if>
            <if test="alarmType != null">#{alarmType},</if>
            <if test="alarmLevel != null">#{alarmLevel},</if>
            <if test="alarmContent != null">#{alarmContent},</if>
            <if test="handleStatus != null">#{handleStatus},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="handleResult != null">#{handleResult},</if>
            <if test="handler != null">#{handler},</if>
        </trim>
    </insert>

    <!-- 更新告警处理状态 -->
    <update id="updateHandleStatus">
        UPDATE t_alarm
        SET handle_status = #{handleStatus},
            handle_time = #{handleTime},
            handle_result = #{handleResult},
            handler = #{handler},
            update_time = NOW(),
            update_by = #{handler}
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- 统计告警类型分布 -->
    <select id="selectAlarmTypeStats" resultType="com.conghua.tourism.model.AlarmTypeStats">
        SELECT 
            alarm_type,
            COUNT(*) as alarm_count
        FROM t_alarm
        WHERE deleted = 0
        <if test="scenicSpotId != null">
            AND scenic_spot_id = #{scenicSpotId}
        </if>
        <if test="startDate != null">
            AND DATE(create_time) >= #{startDate}
        </if>
        <if test="endDate != null">
            AND DATE(create_time) &lt;= #{endDate}
        </if>
        GROUP BY alarm_type
        ORDER BY alarm_count DESC
    </select>

    <!-- 查询未处理的告警 -->
    <select id="selectUnhandledAlarms" resultType="com.conghua.tourism.model.Alarm">
        SELECT
        <include refid="Column_List"/>
        FROM t_alarm
        WHERE deleted = 0
        AND handle_status = 0
        <if test="scenicSpotId != null">
            AND scenic_spot_id = #{scenicSpotId}
        </if>
        ORDER BY alarm_level DESC, create_time DESC
    </select>
</mapper> 