<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenic.ai.mapper.FlowAnalysisMapper">
    
    <resultMap type="com.scenic.ai.model.FlowAnalysis" id="FlowAnalysisResult">
        <id property="id" column="id"/>
        <result property="deviceCode" column="device_code"/>
        <result property="deviceName" column="device_name"/>
        <result property="tourismName" column="tourism_name"/>
        <result property="flowCount" column="flow_count"/>
        <result property="flowDirection" column="flow_direction"/>
        <result property="algName" column="alg_name"/>
        <result property="taskCode" column="task_code"/>
        <result property="imageUrl" column="image_url"/>
        <result property="recordTime" column="record_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectFlowAnalysisVo">
        select id, device_code, device_name, tourism_name, flow_count, flow_direction, 
        alg_name, task_code, image_url, record_time, create_time, update_time
        from flow_analysis
    </sql>

    <select id="selectFlowAnalysisList" parameterType="com.scenic.ai.model.FlowAnalysis" resultMap="FlowAnalysisResult">
        <include refid="selectFlowAnalysisVo"/>
        <where>
            <if test="deviceCode != null and deviceCode != ''">
                AND device_code = #{deviceCode}
            </if>
            <if test="tourismName != null and tourismName != ''">
                AND tourism_name like concat('%', #{tourismName}, '%')
            </if>
            <if test="startTime != null">
                AND record_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND record_time &lt;= #{endTime}
            </if>
        </where>
        order by record_time desc
    </select>

    <select id="selectFlowAnalysisById" parameterType="Long" resultMap="FlowAnalysisResult">
        <include refid="selectFlowAnalysisVo"/>
        where id = #{id}
    </select>

    <insert id="insertFlowAnalysis" parameterType="com.scenic.ai.model.FlowAnalysis" useGeneratedKeys="true" keyProperty="id">
        insert into flow_analysis
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceCode != null">device_code,</if>
            <if test="deviceName != null">device_name,</if>
            <if test="tourismName != null">tourism_name,</if>
            <if test="flowCount != null">flow_count,</if>
            <if test="flowDirection != null">flow_direction,</if>
            <if test="algName != null">alg_name,</if>
            <if test="taskCode != null">task_code,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="recordTime != null">record_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceCode != null">#{deviceCode},</if>
            <if test="deviceName != null">#{deviceName},</if>
            <if test="tourismName != null">#{tourismName},</if>
            <if test="flowCount != null">#{flowCount},</if>
            <if test="flowDirection != null">#{flowDirection},</if>
            <if test="algName != null">#{algName},</if>
            <if test="taskCode != null">#{taskCode},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="recordTime != null">#{recordTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateFlowAnalysis" parameterType="com.scenic.ai.model.FlowAnalysis">
        update flow_analysis
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceCode != null">device_code = #{deviceCode},</if>
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="tourismName != null">tourism_name = #{tourismName},</if>
            <if test="flowCount != null">flow_count = #{flowCount},</if>
            <if test="flowDirection != null">flow_direction = #{flowDirection},</if>
            <if test="algName != null">alg_name = #{algName},</if>
            <if test="taskCode != null">task_code = #{taskCode},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="recordTime != null">record_time = #{recordTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFlowAnalysisById" parameterType="Long">
        delete from flow_analysis where id = #{id}
    </delete>

    <delete id="deleteFlowAnalysisByIds" parameterType="Long">
        delete from flow_analysis where id in 
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectTotalFlowCount" resultType="Integer">
        select sum(flow_count) from flow_analysis
        <where>
            <if test="startTime != null">
                AND record_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND record_time &lt;= #{endTime}
            </if>
        </where>
    </select>

    <select id="selectFlowDirectionStats" resultMap="FlowAnalysisResult">
        select flow_direction, sum(flow_count) as flow_count
        from flow_analysis
        <where>
            <if test="startTime != null">
                AND record_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND record_time &lt;= #{endTime}
            </if>
        </where>
        group by flow_direction
    </select>
    
    <!-- 分页查询客流分析数据 -->
    <select id="selectFlowAnalysisPage" resultMap="FlowAnalysisResult">
        <include refid="selectFlowAnalysisVo"/>
        <where>
            <if test="params.deviceCode != null and params.deviceCode != ''">
                AND device_code = #{params.deviceCode}
            </if>
            <if test="params.deviceName != null and params.deviceName != ''">
                AND device_name like concat('%', #{params.deviceName}, '%')
            </if>
            <if test="params.tourismName != null and params.tourismName != ''">
                AND tourism_name like concat('%', #{params.tourismName}, '%')
            </if>
            <if test="params.flowDirection != null and params.flowDirection != ''">
                AND flow_direction = #{params.flowDirection}
            </if>
            <if test="params.startTime != null">
                AND record_time >= #{params.startTime}
            </if>
            <if test="params.endTime != null">
                AND record_time &lt;= #{params.endTime}
            </if>
        </where>
        order by record_time desc
    </select>
    
    <!-- 查询客流分析记录总数 -->
    <select id="selectFlowAnalysisCount" resultType="Long">
        select count(1) from flow_analysis
        <where>
            <if test="params.deviceCode != null and params.deviceCode != ''">
                AND device_code = #{params.deviceCode}
            </if>
            <if test="params.deviceName != null and params.deviceName != ''">
                AND device_name like concat('%', #{params.deviceName}, '%')
            </if>
            <if test="params.tourismName != null and params.tourismName != ''">
                AND tourism_name like concat('%', #{params.tourismName}, '%')
            </if>
            <if test="params.flowDirection != null and params.flowDirection != ''">
                AND flow_direction = #{params.flowDirection}
            </if>
            <if test="params.startTime != null">
                AND record_time >= #{params.startTime}
            </if>
            <if test="params.endTime != null">
                AND record_time &lt;= #{params.endTime}
            </if>
        </where>
    </select>
</mapper> 