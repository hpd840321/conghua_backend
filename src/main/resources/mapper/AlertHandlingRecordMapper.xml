<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenic.ai.dao.AlertHandlingRecordMapper">
    
    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.scenic.ai.model.AlertHandlingRecord">
        <id column="ID" property="id"/>
        <result column="ALERT_ID" property="alertId"/>
        <result column="HANDLER" property="handler"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="HANDLE_TIME" property="handleTime"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>
    
    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ID, ALERT_ID, HANDLER, DESCRIPTION, HANDLE_TIME, CREATE_TIME, UPDATE_TIME
    </sql>
    
    <!-- 根据告警ID查询处理记录 -->
    <select id="selectByAlertId" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM ALERT_HANDLING_RECORD
        WHERE ALERT_ID = #{alertId}
        ORDER BY HANDLE_TIME DESC
    </select>
    
</mapper> 