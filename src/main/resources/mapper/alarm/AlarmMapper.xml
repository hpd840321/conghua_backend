<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.conghua.tourism.mapper.alarm.AlarmMapper">

    <!-- 告警数据结果映射 -->
    <resultMap id="alarmResultMap" type="com.conghua.tourism.model.alarm.AlarmData">
        <id column="id" property="id"/>
        <result column="type" property="type" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result column="level" property="level" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result column="status" property="status" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result column="message" property="message"/>
        <result column="occur_time" property="occurTime"/>
        <result column="area_id" property="areaId"/>
        <result column="area_name" property="areaName"/>
        <result column="device_id" property="deviceId"/>
        <result column="device_name" property="deviceName"/>
        <result column="handle_time" property="handleTime"/>
        <result column="handler" property="handler"/>
        <result column="handle_remark" property="handleRemark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <!-- 告警配置结果映射 -->
    <resultMap id="configResultMap" type="com.conghua.tourism.model.alarm.AlarmConfig">
        <id column="id" property="id"/>
        <result column="type" property="type" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result column="level" property="level" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result column="area_id" property="areaId"/>
        <result column="area_name" property="areaName"/>
        <result column="device_ids" property="deviceIds" typeHandler="com.conghua.tourism.mapper.handler.StringListTypeHandler"/>
        <result column="threshold" property="threshold"/>
        <result column="duration" property="duration"/>
        <result column="interval" property="interval"/>
        <result column="enabled" property="enabled"/>
        <result column="notification_channels" property="notificationChannels" typeHandler="com.conghua.tourism.mapper.handler.StringListTypeHandler"/>
        <result column="notification_template" property="notificationTemplate"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="creator" property="creator"/>
        <result column="updater" property="updater"/>
    </resultMap>
    
    <!-- 告警趋势数据结果映射 -->
    <resultMap id="trendResultMap" type="com.conghua.tourism.model.alarm.AlarmTrendData">
        <result column="timestamp" property="timestamp"/>
        <result column="total" property="total"/>
        <result column="newCount" property="newCount"/>
        <result column="handledCount" property="handledCount"/>
        <result column="avgHandleTime" property="avgHandleTime"/>
    </resultMap>
    
    <!-- 告警统计数据结果映射 -->
    <resultMap id="statsResultMap" type="com.conghua.tourism.model.alarm.AlarmStats">
        <result column="total" property="total"/>
        <result column="pending" property="pending"/>
        <result column="processing" property="processing"/>
        <result column="resolved" property="resolved"/>
        <result column="ignored" property="ignored"/>
        <result column="autoResolved" property="autoResolved"/>
    </resultMap>
    
    <!-- 通用列 -->
    <sql id="Base_Column_List">
        id, type, level, status, message, occur_time, area_id, area_name, device_id, device_name,
        handle_time, handler, handle_remark, create_time, update_time
    </sql>
    
    <!-- 配置表列 -->
    <sql id="Config_Column_List">
        id, type, level, area_id, area_name, device_ids, threshold, duration, interval, enabled,
        notification_channels, notification_template, create_time, update_time, creator, updater
    </sql>
    
</mapper> 