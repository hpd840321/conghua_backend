<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenic.ai.mapper.DeviceMapper">
    
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.scenic.ai.model.Device">
        <id column="ID" property="id"/>
        <result column="DEVICE_CODE" property="deviceCode"/>
        <result column="DEVICE_NAME" property="deviceName"/>
        <result column="TOURISM_NAME" property="tourismName"/>
        <result column="STATUS" property="status"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>
    
    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        ID, DEVICE_CODE, DEVICE_NAME, TOURISM_NAME, STATUS, CREATE_TIME, UPDATE_TIME
    </sql>
    
    <!-- 查询条件 -->
    <sql id="Query_Condition">
        <where>
            <if test="params.deviceCode != null and params.deviceCode != ''">
                AND DEVICE_CODE = #{params.deviceCode}
            </if>
            <if test="params.deviceName != null and params.deviceName != ''">
                AND DEVICE_NAME LIKE '%' || #{params.deviceName} || '%'
            </if>
            <if test="params.status != null and params.status != ''">
                AND STATUS = #{params.status}
            </if>
            <if test="params.tourismName != null and params.tourismName != ''">
                AND TOURISM_NAME = #{params.tourismName}
            </if>
            <if test="params.startTime != null and params.startTime != ''">
                AND CREATE_TIME >= #{params.startTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND CREATE_TIME &lt;= #{params.endTime}
            </if>
        </where>
    </sql>
    
    <!-- 查询设备总数 -->
    <select id="countDevices" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM CLOUDWALK.DEVICE
        <include refid="Query_Condition"/>
    </select>
    
    <!-- 查询设备列表 -->
    <select id="selectDevices" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM CLOUDWALK.DEVICE
        <include refid="Query_Condition"/>
        <if test="params.sortField != null and params.sortField != ''">
            ORDER BY ${params.sortField} ${params.sortOrder}
        </if>
        OFFSET #{params.current} ROWS FETCH NEXT #{params.pageSize} ROWS ONLY
    </select>
    
    <!-- 根据ID查询设备 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM CLOUDWALK.DEVICE
        WHERE ID = #{id}
    </select>
    
    <!-- 根据景区名称查询设备列表 -->
    <select id="findByTourismName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM CLOUDWALK.DEVICE
        WHERE TOURISM_NAME = #{tourismName}
    </select>
    
    <!-- 根据状态查询设备列表 -->
    <select id="findByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM CLOUDWALK.DEVICE
        WHERE STATUS = #{status}
    </select>
    
    <!-- 条件分页查询 -->
    <select id="findByConditions" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM CLOUDWALK.DEVICE
        <include refid="Query_Condition"/>
        ORDER BY CREATE_TIME DESC
        OFFSET #{params.offset} ROWS FETCH NEXT #{params.pageSize} ROWS ONLY
    </select>
</mapper> 